# riker benchmark pipeline — top-level Snakefile.
#
# Job graph (per (sample, profile, tool, rep) cell):
#   fetch_input -> [transcode_cram | downsample] -> stage/{sample}/input.bam
#       -> {run_riker, run_picard_*, run_mosdepth, run_qualimap}
#       -> aggregate_bench -> bench.tsv -> summarize_bench, plots
#
# Resource semantics: every timed rule reserves bench=100 (the full pool,
# set by run.sh). Staging/aggregation/plotting reserve bench=1, so they
# can run in parallel during fill-in but never DURING a timed rule.
#
# Adding a new comparator: add a rule under workflow/rules/, update
# COMPARATORS in this file, and add it to the plot.R color palette.

import re
from pathlib import Path

import pandas as pd
import yaml


configfile: "config/performance.config.yaml"


WORKDIR = Path(workflow.basedir)


# --- Resolve config paths (snakemake passes them in as relative-to-CWD) ---

def _abs(p: str) -> Path:
    pp = Path(p)
    return pp if pp.is_absolute() else WORKDIR / pp


SAMPLES_WGS_TSV    = _abs(config["samples_wgs_tsv"])
SAMPLES_HYBCAP_TSV = _abs(config["samples_hybcap_tsv"])
REFERENCES_YAML    = _abs(config["references_yaml"])
KITS_YAML          = _abs(config["kits_yaml"])
STAGE_DIR          = _abs(config["stage_dir"])
RESULTS_DIR        = _abs(config["results_dir"])
RIKER_BIN          = _abs(config["riker_bin"])

# RNA benchmarking is optional: a config without these keys (e.g. an older
# wgs/hybcap-only config) simply loads no RNA samples or annotations. The
# RustQC subset config falls back to the in-repo default so the rna rules
# always have a valid path.
SAMPLES_RNA_TSV    = _abs(config["samples_rna_tsv"]) if config.get("samples_rna_tsv") else None
ANNOTATIONS_YAML   = _abs(config["annotations_yaml"]) if config.get("annotations_yaml") else None
RUSTQC_RNA_CONFIG  = _abs(config.get("rustqc_rna_config") or "config/rustqc.rna.subset.yaml")

with open(REFERENCES_YAML) as fh:
    REFERENCES = yaml.safe_load(fh)
with open(KITS_YAML) as fh:
    KITS = yaml.safe_load(fh)
ANNOTATIONS = {}
if ANNOTATIONS_YAML and ANNOTATIONS_YAML.exists():
    with open(ANNOTATIONS_YAML) as fh:
        ANNOTATIONS = yaml.safe_load(fh) or {}


# --- Sample sheets --------------------------------------------------------

def _load_samples():
    """Combine the WGS and hybcap sample sheets into one indexed DataFrame.
    Empty sheets are tolerated (smoke configs may have an empty hybcap
    sheet). Adds the `benchmark` column with default 'Y' if missing."""
    frames = []
    if SAMPLES_WGS_TSV.exists():
        wgs = pd.read_csv(SAMPLES_WGS_TSV, sep="\t", dtype=str).fillna("-")
        if len(wgs) > 0:
            wgs["input_type"] = "wgs"
            frames.append(wgs)
    if SAMPLES_HYBCAP_TSV.exists():
        hyb = pd.read_csv(SAMPLES_HYBCAP_TSV, sep="\t", dtype=str).fillna("-")
        if len(hyb) > 0:
            hyb["input_type"] = "hybcap"
            # hybcap rows lack downsample_* columns; fill with placeholders
            # so the merged frame has uniform schema.
            for c in ("downsample_from", "downsample_frac", "downsample_seed"):
                if c not in hyb.columns:
                    hyb[c] = "-"
            frames.append(hyb)
    if SAMPLES_RNA_TSV is not None and SAMPLES_RNA_TSV.exists():
        rna = pd.read_csv(SAMPLES_RNA_TSV, sep="\t", dtype=str).fillna("-")
        if len(rna) > 0:
            rna["input_type"] = "rna"
            frames.append(rna)
    if not frames:
        raise SystemExit(
            "No samples loaded — check samples_wgs_tsv / samples_hybcap_tsv / samples_rna_tsv"
        )
    df = pd.concat(frames, ignore_index=True)
    # Columns present in only some sheets (rna's annotation/strand, wgs's
    # downsample_*) come out NaN for the other sheets' rows after the concat;
    # normalise to "-" so the subset predicates below (which test for "-"/"")
    # don't misclassify a row on a column its sheet never carried.
    df = df.fillna("-")
    # Default benchmark=Y if column absent. Allows older sample sheets to
    # still work without a forced edit.
    if "benchmark" not in df.columns:
        df["benchmark"] = "Y"
    return df.set_index("name", drop=False)


SAMPLES = _load_samples()
SAMPLE_NAMES = list(SAMPLES.index)
# Samples that actually get benchmarked (vs. samples staged purely as
# downsample parents). DAG fanout uses BENCHMARK_SAMPLES; staging rules
# operate on the full SAMPLES set so parents get fetched.
BENCHMARK_SAMPLES = [s for s in SAMPLE_NAMES if SAMPLES.loc[s, "benchmark"].upper() == "Y"]

# Useful subsets for rule wildcards / DAG construction.
WGS_SAMPLES    = [s for s in SAMPLE_NAMES if SAMPLES.loc[s, "input_type"] == "wgs"]
HYBCAP_SAMPLES = [s for s in SAMPLE_NAMES if SAMPLES.loc[s, "input_type"] == "hybcap"]
# RNA samples have .bam source_urls with no downsample, so they land in
# BAM_SOURCE_SAMPLES below and are fetched as-is to input.bam (coordinate-
# sorted already; no markdup — the RustQC subset drops dupRadar and riker
# uses its non-MC path).
RNA_SAMPLES    = [s for s in SAMPLE_NAMES if SAMPLES.loc[s, "input_type"] == "rna"]
DOWNSAMPLE_SAMPLES = [
    s for s in SAMPLE_NAMES
    if SAMPLES.loc[s, "downsample_from"] not in ("-", "")
]
SOURCE_SAMPLES = [s for s in SAMPLE_NAMES if s not in DOWNSAMPLE_SAMPLES]
CRAM_SOURCE_SAMPLES = [
    s for s in SOURCE_SAMPLES
    if SAMPLES.loc[s, "source_url"].endswith(".cram")
]
BAM_SOURCE_SAMPLES = [
    s for s in SOURCE_SAMPLES
    if not SAMPLES.loc[s, "source_url"].endswith(".cram")
]


# --- Profile + comparator definitions ------------------------------------

# Profile metadata. The riker_args field is exactly what gets passed to
# the riker binary after `--threads N --input ... --output ...`.
PROFILES = {
    # Fair three-way WGS comparison, thread-swept 1-4 for riker and mosdepth
    # (Picard CollectWgsMetrics can't thread → it appears in wgs-t1 only).
    # All three are harmonized to the same read/base selection: MAPQ 20,
    # orphan/unpaired reads counted, duplicates + secondary + supplementary
    # excluded, mosdepth in accurate mode (no -x fast, no -a fragment). riker
    # and Picard additionally keep base-quality filtering (their feature;
    # mosdepth can't BQ-filter). The trailing -t{N} encodes the thread budget.
    "wgs-t1": {"input_type": "wgs", "riker_args": ["wgs", "--include-unpaired-reads"], "needs_ref": True},
    "wgs-t2": {"input_type": "wgs", "riker_args": ["wgs", "--include-unpaired-reads"], "needs_ref": True},
    "wgs-t3": {"input_type": "wgs", "riker_args": ["wgs", "--include-unpaired-reads"], "needs_ref": True},
    "wgs-t4": {"input_type": "wgs", "riker_args": ["wgs", "--include-unpaired-reads"], "needs_ref": True},
    "wgs-bundle": {
        "input_type": "wgs",
        "riker_args": ["multi", "--tools", "wgs", "alignment", "basic", "isize", "gcbias"],
        "needs_ref": True,
    },
    "hybcap-only": {
        "input_type": "hybcap",
        "riker_args": ["hybcap"],
        "needs_ref": False,
    },
    "hybcap-bundle": {
        "input_type": "hybcap",
        "riker_args": ["multi", "--tools", "hybcap", "alignment", "basic", "isize"],
        "needs_ref": False,
    },
    # RNA thread-sweep: riker rna vs Picard CollectRnaSeqMetrics vs a
    # scope-matched RustQC subset. The trailing -t{N} encodes the thread
    # budget (see thread_count); riker + rustqc run at each of 1/2/4, while
    # Picard (single-threaded) appears only in rna-t1.
    "rna-t1": {"input_type": "rna", "riker_args": ["rna"], "needs_ref": False},
    "rna-t2": {"input_type": "rna", "riker_args": ["rna"], "needs_ref": False},
    "rna-t4": {"input_type": "rna", "riker_args": ["rna"], "needs_ref": False},
}

# Comparator coverage matrix — which tools run against which profile.
# Each entry is a list of (tool_token, role) tuples. tool_token is the
# directory name under results/run/{sample}/{profile}/; role is for the
# bench.tsv `picard_bundle_role` column (and ignored otherwise).
# Qualimap was originally in this matrix but was dropped from v1 after
# repeatedly failing on 30x WGS at both 16 GB and 24 GB Java heap (and
# user explicitly approved "screw it" as the response). The qualimap
# rule still exists in workflow/rules/run_qualimap.smk; re-add it to
# COMPARATORS to bring it back when running on a beefier host.
COMPARATORS = {
    # riker + mosdepth thread-swept 1-4; picard-cwm (single-thread) in t1 only.
    "wgs-t1": [
        ("riker",      "main"),
        ("picard-cwm", "main"),        # CollectWgsMetrics (single-threaded → t1 only)
        ("mosdepth",   "main"),        # accurate + harmonized (see run_mosdepth.smk)
    ],
    "wgs-t2": [
        ("riker",    "main"),
        ("mosdepth", "main"),
    ],
    "wgs-t3": [
        ("riker",    "main"),
        ("mosdepth", "main"),
    ],
    "wgs-t4": [
        ("riker",    "main"),
        ("mosdepth", "main"),
    ],
    "wgs-bundle": [
        ("riker",          "main"),
        ("picard-cmm",     "base"),    # CollectMultipleMetrics + GcBias
        ("picard-cwm",     "supp"),    # CollectWgsMetrics (added on top)
    ],
    "hybcap-only": [
        ("riker",       "main"),
        ("picard-chsm", "main"),       # CollectHsMetrics
        ("mosdepth",    "main"),
    ],
    "hybcap-bundle": [
        ("riker",          "main"),
        ("picard-cmm",     "base"),    # CollectMultipleMetrics (default 5 programs)
        ("picard-chsm",    "supp"),
    ],
    "rna-t1": [
        ("riker",       "main"),
        ("picard-crsm", "main"),   # CollectRnaSeqMetrics (single-threaded → t1 only)
        ("rustqc",      "main"),   # scope-matched RustQC subset
    ],
    "rna-t2": [
        ("riker",  "main"),
        ("rustqc", "main"),
    ],
    "rna-t4": [
        ("riker",  "main"),
        ("rustqc", "main"),
    ],
}

PROFILES_ENABLED = config["profiles_enabled"]
REPLICATES = list(range(1, int(config["replicates"]) + 1))


# --- Per-sample helpers ---------------------------------------------------

def ref_for_sample(sample: str) -> str:
    """Path to the indexed FASTA used for staging + benchmarking this sample."""
    ref_name = SAMPLES.loc[sample, "reference"]
    return f"{STAGE_DIR}/refs/{ref_name}.fa"


def kit_intervals_for_sample(sample: str) -> str:
    """Picard interval_list path. Used by riker hybcap and Picard
    CollectHsMetrics (both natively accept interval_list)."""
    kit = SAMPLES.loc[sample, "kit"] if "kit" in SAMPLES.columns else "-"
    return f"{STAGE_DIR}/kits/{kit}/intervals.list"


def kit_bed_for_sample(sample: str) -> str:
    """BED path derived from the interval_list. Used by mosdepth (which
    only accepts BED via --by)."""
    kit = SAMPLES.loc[sample, "kit"] if "kit" in SAMPLES.columns else "-"
    return f"{STAGE_DIR}/kits/{kit}/intervals.bed"


# Back-compat aliases — the Agilent v5 kit uses one interval_list file as
# both baits and targets (vendor login wall on the separate BED files;
# ~100% bait-target overlap is acceptable for runtime benchmarking).
def bait_bed_for_sample(sample: str) -> str:
    return kit_intervals_for_sample(sample)


def target_bed_for_sample(sample: str) -> str:
    return kit_intervals_for_sample(sample)


def thread_count(profile: str) -> int:
    """Threads for a profile. Single-tool profiles run 1; bundle profiles
    run 4; the RNA thread-sweep profiles encode their budget in a trailing
    -t{N} suffix (rna-t1/-t2/-t4)."""
    m = re.search(r"-t(\d+)$", profile)
    if m:
        return int(m.group(1))
    return 4 if profile.endswith("-bundle") else 1


def annotation_for_sample(sample: str) -> str:
    return SAMPLES.loc[sample, "annotation"]


def gene_model_gtf_for_sample(sample: str) -> str:
    """GENCODE GTF path — read directly by riker rna (--gene-model) and
    rustqc (--gtf), and the source for the derived refFlat + ribosomal
    interval_list."""
    return f"{STAGE_DIR}/annotations/{annotation_for_sample(sample)}/genes.gtf.gz"


def refflat_for_sample(sample: str) -> str:
    """refFlat derived from the GTF, for Picard CollectRnaSeqMetrics REF_FLAT."""
    return f"{STAGE_DIR}/annotations/{annotation_for_sample(sample)}/refFlat.txt"


def ribosomal_intervals_for_sample(sample: str) -> str:
    """Per-sample rRNA interval_list (BAM @SQ header + GTF rRNA loci) for
    Picard CollectRnaSeqMetrics RIBOSOMAL_INTERVALS."""
    return f"{STAGE_DIR}/{sample}/ribosomal.interval_list"


def strand_for_sample(sample: str) -> str:
    """riker --strand / rustqc token: forward | reverse | unstranded."""
    return SAMPLES.loc[sample, "strand"]


# Picard STRAND_SPECIFICITY tokens for CollectRnaSeqMetrics.
_PICARD_STRAND = {
    "forward":    "FIRST_READ_TRANSCRIPTION_STRAND",
    "reverse":    "SECOND_READ_TRANSCRIPTION_STRAND",
    "unstranded": "NONE",
}


def picard_strand_for_sample(sample: str) -> str:
    return _PICARD_STRAND[strand_for_sample(sample)]


# --- DAG fan-out ----------------------------------------------------------

def all_bench_targets():
    out = []
    for sample in BENCHMARK_SAMPLES:
        input_type = SAMPLES.loc[sample, "input_type"]
        for profile in PROFILES_ENABLED:
            if PROFILES[profile]["input_type"] != input_type:
                continue
            for tool_token, _role in COMPARATORS[profile]:
                for rep in REPLICATES:
                    out.append(
                        f"{RESULTS_DIR}/run/{sample}/{profile}/{tool_token}/rep{rep}/time.txt"
                    )
    return out


# --- Top-level rule -------------------------------------------------------

rule all:
    input:
        f"{RESULTS_DIR}/bench.tsv",
        f"{RESULTS_DIR}/bench_summary.tsv",
        f"{RESULTS_DIR}/host.json",
        f"{RESULTS_DIR}/plots/01_wall_time_leaderboard.pdf",
        f"{RESULTS_DIR}/plots/02_throughput_vs_size.pdf",
        f"{RESULTS_DIR}/plots/03_max_rss_vs_size.pdf",
        f"{RESULTS_DIR}/plots/04_riker_bundle_vs_picard.pdf",
        f"{RESULTS_DIR}/plots/05_riker_vs_picard_cmm.pdf",
        f"{RESULTS_DIR}/plots/06_per_comparator_ratio.pdf",


# --- Wildcard constraints (must match disjoint subsets) -------------------

# Snakemake rule resolution depends on these constraints to pick the right
# upstream for stage/{sample}/input.bam. All sample-name constraints use
# the same set of names so any rule can match by sample.
_PROFILE_REGEX = "|".join(PROFILES.keys())
_REP_REGEX = r"\d+"
_TOOL_REGEX = "riker|picard-cmm|picard-cwm|picard-chsm|picard-crsm|mosdepth|qualimap|rustqc"


wildcard_constraints:
    sample = "|".join(SAMPLE_NAMES) if SAMPLE_NAMES else "DOESNOTMATCH",
    profile = _PROFILE_REGEX,
    tool = _TOOL_REGEX,
    rep = _REP_REGEX,


